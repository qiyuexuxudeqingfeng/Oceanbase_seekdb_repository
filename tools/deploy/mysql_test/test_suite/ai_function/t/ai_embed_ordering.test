#owner: oceanbase
#owner group: shenzhen

connection default;

--error 0,11118
call DBMS_AI_SERVICE.DROP_AI_MODEL('ordering_embed');
--error 0,11112
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('ordering_embed_ep');
call DBMS_AI_SERVICE.CREATE_AI_MODEL(
  'ordering_embed', '{"type":"dense_embedding","model_name":"ordering-embedding-v1"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT(
  'ordering_embed_ep', '{"ai_model_name":"ordering_embed","scope":"all","url":"http://0.0.0.0:8000/compatible-mode/v1/embeddings","access_key":"mock-key","provider":"openai"}');

--disable_warnings
drop table if exists ai_embed_order;
drop table if exists ai_embed_order_vectors;
drop table if exists ai_embed_order_gaps;
drop table if exists ai_embed_order_gap_vectors;
--enable_warnings
create table ai_embed_order(id int primary key, content text);
insert into ai_embed_order values(1,'first'),(2,'second');
# ai_embed 必须作为投影的顶层输出表达式才会走 eval_batch；
# 先落盘为 JSON，再在独立的 SELECT 中校验，避免嵌套在 json_extract 里退化为逐行求值。
create table ai_embed_order_vectors(id int primary key, embedding json);
insert into ai_embed_order_vectors
  select id, ai_embed('ordering_embed', content) from ai_embed_order order by id;
select id, json_extract(embedding, '$[0]') = id as in_original_order
  from ai_embed_order_vectors order by id;
drop table ai_embed_order_vectors;
drop table ai_embed_order;

# NULL 行不进入请求：同一模型应再产生一次 first/third 分组
create table ai_embed_order_gaps(id int primary key, content text);
insert into ai_embed_order_gaps values(1,'first'),(2,null),(3,'third');
create table ai_embed_order_gap_vectors(id int primary key, embedding json);
insert into ai_embed_order_gap_vectors
  select id, ai_embed('ordering_embed', content) from ai_embed_order_gaps order by id;
select id, cast(json_unquote(json_extract(embedding, '$[0]')) as signed) as first_element
  from ai_embed_order_gap_vectors order by id;
drop table ai_embed_order_gap_vectors;
drop table ai_embed_order_gaps;

call DBMS_AI_SERVICE.DROP_AI_MODEL('ordering_embed');
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('ordering_embed_ep');
