seekdb:
{{%% SERVERS %%}}
  tag: latest
  include: obd/observer.include.yaml
  global: 
    # for default system config used by farm, please see tools/deploy/obd/observer.include.yaml
    # You can also specify the configuration directly below (stored locally, switching the working directory and redeploying will still take effect)
    production_mode: false
    # Keep the footprint small enough for a single shared runner: the engine
    # refuses to bootstrap when OBD sizes the tenant from the host's nominal
    # capacity, which is far larger than the runner's free memory.
    memory_budget: '1G'
    datafile_size: '2G'
    log_disk_size: '2G'
    # cpu_count: '24'
